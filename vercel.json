{
  "framework": "nextjs",
  "buildCommand": "next build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/check-subscriptions",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/abandoned-reminder",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/weekly-report",
      "schedule": "0 8 * * 0"
    },
    {
      "path": "/api/cron/inactive-clients",
      "schedule": "0 9 * * *"
    }
  ]
}
